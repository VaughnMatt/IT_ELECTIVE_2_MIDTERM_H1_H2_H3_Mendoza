@model PosApp.Models.ShoppingCart

<h2 class="mb-4">🛒 Active Shopping Cart</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Your cart is currently empty. <a asp-controller="Products" asp-action="Index">Browse store catalog</a>.
    </div>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Unit Price</th>
                <th style="width: 180px;">Quantity</th>
                <th>Line Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>$@item.UnitPrice.ToString("F2")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                            <input type="number" name="Quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                        </form>
                    </td>
                    <td>$@item.LineTotal.ToString("F2")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="Remove" method="post">
                            <input type="hidden" name="ProductId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4>Grand Total: <span class="text-success">$@Model.GrandTotal.ToString("F2")</span></h4>
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success btn-lg">Proceed to Checkout</a>
    </div>
}