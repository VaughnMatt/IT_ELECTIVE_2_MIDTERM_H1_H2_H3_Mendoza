@model IEnumerable<PosApp.Models.Product>

<h2 class="mb-4">🕹️ PixelVault Catalog</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    @foreach (var p in Model)
    {
        bool isOutOfStock = p.StockQuantity == 0;
        <div class="col-md-4 mb-4">
            <div class="card h-100 @(isOutOfStock ? "bg-light text-muted opacity-75" : "")">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title fw-bold">@p.Name</h5>
                        <p class="card-text">
                            <strong>Price:</strong> $@p.Price.ToString("F2")<br />
                            <strong>Stock:</strong>
                            @if (isOutOfStock)
                            {
                                <span class="badge bg-secondary">Out of Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@p.StockQuantity available</span>
                            }
                        </p>
                    </div>

                    @if (!isOutOfStock)
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex gap-2 mt-3">
                            <input type="hidden" name="ProductId" value="@p.Id" />
                            <input type="number" name="Quantity" value="1" min="1" max="@p.StockQuantity" class="form-control" style="width: 80px;" />
                            <button type="submit" class="btn btn-primary w-100">Add to Cart</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>